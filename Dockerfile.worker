FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 QT_QPA_PLATFORM=offscreen COLMAP_USE_GPU=0 JOB_DIR=/data/jobs
RUN apt-get update && apt-get install -y --no-install-recommends colmap ffmpeg libgl1 libglib2.0-0 libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY gsplat_keras ./gsplat_keras
COPY worker ./worker
RUN pip install --no-cache-dir . "tensorflow==2.16.2" "numpy<2" opencv-python-headless Pillow scipy tqdm yt-dlp fastapi uvicorn
RUN useradd -m -u 10001 worker && mkdir -p /data/jobs && chown -R worker:worker /data
USER worker
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)"
CMD ["uvicorn","worker.server:app","--host","0.0.0.0","--port","8000","--workers","1"]
